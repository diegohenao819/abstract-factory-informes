@startuml v3-pedido
title Versión 3: se agrega el tipo PEDIDO (nuevo en verde, modificado en naranja)
skinparam classAttributeIconSize 0
skinparam nodesep 50
skinparam ranksep 70
hide empty members

' Fila 1: cliente y fábrica abstracta
class Cliente #orange {
  procesarInformes(reports, fabricas)
}

abstract class FabricaInformes #orange {
  {abstract} crearFactura() : Factura
  {abstract} crearCompra() : Compra
  {abstract} crearPedido() : Pedido
}

' Fila 2: una fábrica por categoría
class FabricaEntrada #orange {
  crearFactura() : Factura
  crearCompra() : Compra
  crearPedido() : Pedido
}

class FabricaSalida #orange {
  crearFactura() : Factura
  crearCompra() : Compra
  crearPedido() : lanza un error
}

class FabricaMixta #orange {
  crearFactura() : Factura
  crearCompra() : Compra
  crearPedido() : lanza un error
}

' Fila 3: los informes de cada familia, debajo de su fábrica
together {
  class FacturaEntrada
  class CompraEntrada
  class PedidoEntrada #palegreen
}

together {
  class FacturaSalida
  class CompraSalida
}

together {
  class FacturaMixta
  class CompraMixta
}

' Fila 4: productos abstractos
abstract class Factura {
  {abstract} procesar(archivo)
}

abstract class Compra {
  {abstract} procesar(archivo)
}

abstract class Pedido #palegreen {
  {abstract} procesar(archivo)
}

Cliente -right-> FabricaInformes : usa

FabricaInformes <|-down- FabricaEntrada
FabricaInformes <|-down- FabricaSalida
FabricaInformes <|-down- FabricaMixta

FabricaEntrada .down.> FacturaEntrada : crea
FabricaEntrada .down.> CompraEntrada : crea
FabricaEntrada .down.> PedidoEntrada : crea
FabricaSalida .down.> FacturaSalida : crea
FabricaSalida .down.> CompraSalida : crea
FabricaMixta .down.> FacturaMixta : crea
FabricaMixta .down.> CompraMixta : crea

FacturaEntrada -down-|> Factura
FacturaSalida -down-|> Factura
FacturaMixta -down-|> Factura
CompraEntrada -down-|> Compra
CompraSalida -down-|> Compra
CompraMixta -down-|> Compra
PedidoEntrada -down-|> Pedido

note right of FabricaInformes
  Al agregar un tipo de informe nuevo
  hay que cambiar la fábrica abstracta
  y todas las fábricas concretas.
end note
@enduml
